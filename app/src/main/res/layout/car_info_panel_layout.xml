<?xml version="1.0" encoding="utf-8"?>
<!-- 左侧 1/4 车辆信息区（对齐参考图：挡位/胎压车模/油耗/能耗 + 4 车控按钮） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E6141B26"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="26dp"
    android:paddingBottom="20dp">

    <!-- 顶部：挡位 + 保电状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gearText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:background="@drawable/car_gear_bg"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/batteryModeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="强制 0%"
            android:textColor="#FFE6A23C"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 中部：小车模 + 胎压 -->
    <com.ljbyd.launcher3.pip.CarTopView
        android:id="@+id/carTopView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="180dp" />

    <!-- 综合油耗 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="综合油耗"
            android:textColor="#FF8FA3B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/fuelText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0.0L/100km"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 行驶 / 里程 / 能耗 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="行驶"
                android:textColor="#FF8FA3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/driveTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0时6分"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="里程"
                android:textColor="#FF8FA3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/mileageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0km"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="能耗"
                android:textColor="#FF8FA3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/energyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0kWh+0.0L"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部：4 个车控快捷按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHalfWindow"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/car_btn_bg"
                android:text="半开窗"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnCloseWindow"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/car_btn_bg"
                android:text="关窗"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnRecovery"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/car_btn_bg"
                android:text="动能回收"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnBatteryMode"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/car_btn_bg"
                android:text="强制保电"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 当前状态行：动能回收 / 保电 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/recoveryStateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="回收:标准"
                android:textColor="#FF8FA3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/batteryStateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="保电:智能"
                android:textColor="#FF8FA3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
